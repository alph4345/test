  (text "Power switch + wake logic"
    (at 201.93 24.13 0)
    (effects
      (font (size 2 2) bold)
      (justify left bottom)
    )
    (uuid "a2246b8b-590f-458c-a961-506f32203831")
  )
  (text "Q5 feeds VSYS while EN_SYS is high: button (SW1), RTC alarm, WAKE,\nUSB (JP1, default on), HOLD from firmware, or JP2 (always on).\nC8 holds EN_SYS ~4-6 s after a press so firmware can raise HOLD.\nQ8 (supervisor) sits under Q6: below the cut-off nothing turns it on."
    (at 201.93 134.62 0)
    (effects
      (font (size 1.27 1.27))
      (justify left top)
    )
    (uuid "96727300-479d-43ba-bf17-d641c8ef3e22")
  )
