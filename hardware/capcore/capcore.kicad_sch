  (text "Power flags (ERC only)"
    (at 241.3 193.04 0)
    (effects
      (font (size 1.27 1.27))
      (justify left bottom)
    )
    (uuid "7ea72a14-f654-41ce-95b9-7e1e7f7bb39d")
  )
  (text "CapCore v1.0 - supercapacitor power module\n\nBuild variants differ only in R4 and R13:\n  LIC  (3.8 V hybrid supercap): R4 120k, R13 330k\n       charge 3.71 V, cut-off 2.61 V\n  EDLC (2.7 V supercap): R4 75k, R13 470k\n       charge 2.62 V, cut-off 1.96 V\nNever fit a 2.7 V EDLC to a board built\nwith the LIC values.\n\nStandby (gadget off) ~5 uA; cut-off and\nship mode draw only leakage.\nFirmware: raise HOLD at boot, drop it to\npower off."
    (at 241.3 223.52 0)
    (effects
      (font (size 1.27 1.27))
      (justify left top)
    )
    (uuid "2c1c2a81-10a9-4e8b-8a17-eeef684fe868")
  )
  (sheet_instances
    (path "/" (page "1"))
  )
)
